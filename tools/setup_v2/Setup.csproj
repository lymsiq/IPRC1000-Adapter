<Project Sdk="Microsoft.NET.Sdk">

  <!-- 引导安装程序：目标 .NET Framework 4.8（Win10 1903+ / Win11 自带，用户端零依赖）
       · 单文件：把免运行时版（含 .NET 8）整包作为资源嵌进来
       · 管理员清单：装到 Program Files + 建快捷方式 + 跑部署脚本 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IPRC1000AdapterSetup</AssemblyName>
    <ApplicationIcon>..\..\iprc1000_gui_dotnet\ui\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Version is passed by tools/build_setup.py from the application project. -->
    <Version Condition="'$(AppVersion)' != ''">$(AppVersion)</Version>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>x64</PlatformTarget>
    <Company>IPRC1000_Adapter contributors</Company>
    <Product>IPRC1000 遥控器适配器 安装程序</Product>
    <Copyright>Based on IPRC1000 Adapter contributors, MIT License</Copyright>
  </PropertyGroup>

  <Target Name="RequireProductVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AppVersion)' == ''" Text="Build this installer using tools/build_setup.py so its version and embedded payload match the application project." />
  </Target>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 载荷：免运行时版整包（构建前由 tools/build_setup.py 复制到这里） -->
    <EmbeddedResource Include="payload.zip">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
