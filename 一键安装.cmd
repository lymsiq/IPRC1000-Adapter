@echo off
chcp 936 >nul
REM ============================================================
REM  IPRC1000 一键安装
REM  一次做完：虚拟声卡 + 键盘驱动 + 遥控器改造 + 默认麦克风
REM  每一步装完都会立刻复检真实状态（不是只看安装程序的退出码）。
REM  需要管理员权限；没有会自动请求一次。
REM ============================================================
net session >nul 2>&1
if %errorlevel% neq 0 (
  echo 正在请求管理员权限，请在弹出的窗口里点「是」...
  powershell -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  exit /b
)
cd /d "%~dp0"
echo.
IPRC1000-Native.exe --install
echo.
echo ------------------------------------------------------------
echo 如果上面提示「需要重启」，请重启一次电脑（重启后不用再装）。
echo 如果提示「必须手动」，请按它给的步骤处理后再点一次本脚本。
echo ------------------------------------------------------------
pause
