<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IPRC1000 Adapter</AssemblyName>
    <RootNamespace>Iprc1000Adapter</RootNamespace>
    <ApplicationIcon>ui\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 关键：框架依赖 + 单文件 → 用系统 .NET 8 Desktop 运行时，不打包运行时 -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- ── 版本信息 ──
         改版本只需要改下面这一个 <Version>：程序内显示、exe 文件属性、
         发布包文件名（package.py 会读它）都从这里取，避免多处各写一份而漂移。 -->
    <Version>1.0.5</Version>
    <FileVersion>1.0.5.0</FileVersion>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <Product>IPRC1000 遥控器适配器</Product>
    <Company>IPRC1000 Adapter contributors</Company>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

  <!-- 把构建时间写进程序集元数据：界面显示"构建于 …"，
       用来一眼判断手上的 exe 是不是刚编译的那个（本项目反复吃过这个亏）。 -->
  <PropertyGroup>
    <BuildStamp>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</BuildStamp>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildStamp</_Parameter1>
      <_Parameter2>$(BuildStamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- 用系统 WebView2（Edge），不打包 Chromium —— 这就是体积只有 MB 级的原因 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- 写 CABLE Input 用的 WASAPI 封装（约 1 MB） -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- 去掉用不到的 WebView2 WPF 程序集。
       本程序只用 WinForms 版（Microsoft.Web.WebView2.WinForms），
       但包的 lib_manual 是 net5.0-windows10.0.17763.0，与 net8.0-windows 匹配，
       于是 WPF 版也被引用进来 —— 它引用 WindowsBase 5.0，而 WinForms 用 4.0，
       两者冲突会刷出 22 条 MSB3277。
       必须在 ResolveAssemblyReferences **之前**从引用列表移除（RAR 是发警告的那一步）。 -->
  <Target Name="DropUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SDK 默认会把 .exe/.dll 排除在 Copy 之外，这里显式把整个 assets 补拷到 publish -->
  <Target Name="CopyExtraAssets" AfterTargets="Publish">
    <ItemGroup>
      <ExtraAsset Include="$(MSBuildProjectDirectory)\assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtraAsset)"
          DestinationFiles="@(ExtraAsset->'$(PublishDir)assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
