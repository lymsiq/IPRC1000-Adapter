<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IPRC1000 Adapter</AssemblyName>
    <RootNamespace>Iprc1000Adapter</RootNamespace>
    <ApplicationIcon>ui\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 关键：框架依赖 + 单文件 → 用系统 .NET Desktop 运行时，不打包运行时 -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- ★ 放宽运行时版本门槛
         默认策略（Minor）会**锁死在 8.x** —— 机器上只装了 .NET 9/10/11 的话，
         双击程序会直接弹「需要下载 .NET」，而我们编译时用的 API 完全兼容它们。
         Major = 缺 8.x 时向上找最低可用的更高主版本 → 装 8/9/10/11 任一都能跑。
         这直接减少了一整类「客户机上必须先装 .NET 8」的部署摩擦。 -->
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- ── 版本信息 ──
         改版本只需要改下面这一个 <Version>：程序内显示、exe 文件属性、
         发布包文件名（package.py 会读它）都从这里取，避免多处各写一份而漂移。 -->
    <Version>1.2.116</Version>
    <!-- 让 exe 的「文件版本」也等于发布版本；否则 FileVersion 停在默认 1.2.0.0，
         安装器的"已安装版本"提示会读错（2026-10-29 实测踩到） -->
    <FileVersion>$(Version)</FileVersion>
    <!-- 旧的写死 FileVersion 已删除：它排在上面那条之后会把 $(Version) 覆盖掉（2026-10-29 实测 FileVersion 停在 1.2.0.0） -->
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <Product>IPRC1000 遥控器适配器</Product>
    <Company>IPRC1000 Adapter contributors</Company>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

  <!-- 把构建时间写进程序集元数据：界面显示"构建于 …"，
       用来一眼判断手上的 exe 是不是刚编译的那个（本项目反复吃过这个亏）。 -->
  <PropertyGroup>
    <BuildStamp>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</BuildStamp>
  </PropertyGroup>

  <!-- 开发/调试工具开关。
       true（默认，dotnet build 与开发用 publish）→ 定义 IPRC_DEV：
         编译进自检与诊断入口（selftest、jitter、keypath、keylog、mouseact、inject 等）。
       false（package.py 打包时传 -p:DevTools=false）→ 这些入口根本不编译进 exe。
       用户要求：调试工具只在开发时存在，发包时去除。 -->
  <PropertyGroup>
    <DevTools Condition="'$(DevTools)' == ''">true</DevTools>
    <DefineConstants Condition="'$(DevTools)' == 'true'">$(DefineConstants);IPRC_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildStamp</_Parameter1>
      <_Parameter2>$(BuildStamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- 用系统 WebView2（Edge），不打包 Chromium —— 这就是体积只有 MB 级的原因 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- 写 CABLE Input 用的 WASAPI 封装（约 1 MB） -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- 去掉用不到的 WebView2 WPF 程序集。
       本程序只用 WinForms 版（Microsoft.Web.WebView2.WinForms），
       但包的 lib_manual 是 net5.0-windows10.0.17763.0，与 net8.0-windows 匹配，
       于是 WPF 版也被引用进来 —— 它引用 WindowsBase 5.0，而 WinForms 用 4.0，
       两者冲突会刷出 22 条 MSB3277。
       必须在 ResolveAssemblyReferences **之前**从引用列表移除（RAR 是发警告的那一步）。 -->
  <Target Name="DropUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SDK 默认会把 .exe/.dll 排除在 Copy 之外，这里显式把整个 assets 补拷到 publish -->
  <Target Name="CopyExtraAssets" AfterTargets="Publish">
    <ItemGroup>
      <ExtraAsset Include="$(MSBuildProjectDirectory)\assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtraAsset)"
          DestinationFiles="@(ExtraAsset->'$(PublishDir)assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>


  <!-- ★★ 2026-10-29：把 WPF 与设计期程序集从发布输出里剔掉。
       原因：`UseWindowsForms` 会带上整个 Microsoft.WindowsDesktop.App 框架，而自包含发布
       会把框架里的**所有**程序集都拷进去 —— 其中 WPF 一套（PresentationFramework 15.4MB +
       PresentationCore 8.2MB + D3DCompiler 4.5MB …）本程序一个都不用。
       实测：删掉后窗口/WebView2/按键全部正常；压缩单文件 63.8MB → 约 35MB。
       用 ResolvedFileToPublish 剔除，对单文件与文件夹发布都生效。 -->
  <Target Name="DropUnusedDesktopPayload" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'PresentationFramework'
                or '%(Filename)' == 'PresentationCore'
                or '%(Filename)' == 'PresentationUI'
                or '%(Filename)' == 'ReachFramework'
                or '%(Filename)' == 'System.Printing'
                or '%(Filename)' == 'System.Windows.Controls.Ribbon'
                or '%(Filename)' == 'System.Windows.Forms.Design'
                or '%(Filename)' == 'D3DCompiler_47_cor3'
                or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64'" />
    </ItemGroup>
  </Target>
</Project>
